# Copy this file to .env and add your own Gemini Developer API key locally.
# Never commit or share the .env file.
GEMINI_API_KEY=

# Optional. Leave this value or change it to a Gemini model available to your API key.
GEMINI_MODEL=gemini-3.1-flash-lite

# stdio uses the local server; http uses the remote HTTPS endpoint.
PHARMACY_MCP_TRANSPORT=stdio
PHARMACY_MCP_URL=https://mcp.canchonfc.online/mcp
PHARMACY_MCP_TOKEN=

# Optional, only for a controlled Wireshark capture of MCP (never Gemini).
# MCP_TLS_KEYLOG_FILE=logs/captures/mcp-tls.keys
